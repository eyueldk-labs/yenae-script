{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yenae Script",
  "version": "0.1.0",
  "identifier": "app.yenae.script",
  "build": {
    "beforeDevCommand": "bun run prepare:app && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run prepare:app && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "externalBin": [
      "binaries/bun"
    ],
    "resources": {
      "resources/engine/": "engine/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "template": "./windows/installer.nsi",
        "sidebarImage": "./windows/sidebar.bmp",
        "installerIcon": "./icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzMkEyNEY5QUY2ODgxRkIKUldUN2dXaXYrU1FxODZjM0xsL1RpRC9hSEoyWUxUTXZQd2YzVklGNWxoODErS0tDenpQWEtwNjYK",
      "endpoints": [
        "https://github.com/eyueldk-labs/yenae-script/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
